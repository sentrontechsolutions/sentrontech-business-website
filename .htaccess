# ----------------------------------------------------------------------
# Sentron Tech Solutions - Security & Access Hardening
# ----------------------------------------------------------------------

# 1. Disable Directory Indexing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# 2. Block Direct Web Access to Sensitive & Hidden Files
# Absolutely blocks .env, .env.local, .git, .gitignore, .htaccess, etc.
<FilesMatch "^\.|\.(env.*|bak|config|sql|ini|log|sh|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Specifically deny any file starting with .env
<Files ~ "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 3. Security Response Headers
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Prevent Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Enable Cross-Site Scripting filter
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Standard MIME Types & UTF-8 Encoding
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddType image/webp .webp
    AddType image/png .png
    AddType image/svg+xml .svg
</IfModule>
